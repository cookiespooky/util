# Конфигурация Apache для корня сайта на виртуальном хостинге reg.ru.
# Скрипт выкладки кладёт этот файл в корень как .htaccess.
#
# На VPS та же задача решается конфигом nginx (api/nginx.sample.conf), где
# бэкенд лежит рядом с корнем статики. Здесь доступа к конфигу сервера нет,
# поэтому api/ вынужденно находится внутри корня — и всё лишнее в нём
# закрывается правилами ниже.

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# --- Единственный адрес сайта: https без www -------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # SSL терминирует nginx, до Apache запрос доходит по HTTP, поэтому
  # %{HTTPS} здесь всегда пустой и проверять его нельзя — получится
  # бесконечный редирект. Признаки защищённого соединения на этом
  # хостинге: порт 443 и заголовок от прокси.
  RewriteCond %{SERVER_PORT} !^443$
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Закрытый бэкенд -------------------------------------------------------
# Наружу отдаются только два эндпоинта. Конфиг с паролем от почты, библиотеки
# и выгруженные справочники доступны PHP-скриптам, но не по HTTP.
<FilesMatch "^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/api/lib/
RedirectMatch 404 ^/api/site-data\.generated\.json$
RedirectMatch 404 ^/api/nginx\.sample\.conf$
RedirectMatch 404 ^/storage(/|$)

# --- Защитные заголовки ----------------------------------------------------
# HSTS без includeSubDomains намеренно: сертификат почтового поддомена пока
# не выпущен, и директива сломала бы к нему доступ по HTTPS. Добавить, когда
# сертификат будет на месте.
#
# Полноценный Content-Security-Policy здесь не задаётся: в разметке есть
# инлайновые <script> и JSON-LD, для них нужны nonce или хеши, а это отдельная
# работа. Ограничиваемся запретом встраивания сайта в чужие фреймы —
# frame-ancestors, современная замена X-Frame-Options.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Кеш ассетов -----------------------------------------------------------
# Имена файлов без хеша, поэтому длинный кеш опасен: после выкладки посетитель
# получит новую разметку со старым CSS. Короткий срок плюс ETag.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
