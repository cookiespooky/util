# Конфигурация Apache для корня сайта на виртуальном хостинге reg.ru.
# Скрипт выкладки кладёт этот файл в корень как .htaccess.
#
# На VPS та же задача решается конфигом nginx (api/nginx.sample.conf), где
# бэкенд лежит рядом с корнем статики. Здесь доступа к конфигу сервера нет,
# поэтому api/ вынужденно находится внутри корня — и всё лишнее в нём
# закрывается правилами ниже.

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# --- Единственный адрес сайта: https без www -------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # SSL терминирует nginx, до Apache запрос доходит по HTTP, поэтому
  # %{HTTPS} здесь всегда пустой и проверять его нельзя — получится
  # бесконечный редирект. Признаки защищённого соединения на этом
  # хостинге: порт 443 и заголовок от прокси.
  RewriteCond %{SERVER_PORT} !^443$
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# --- Закрытый бэкенд -------------------------------------------------------
# Наружу отдаются только два эндпоинта. Конфиг с паролем от почты, библиотеки
# и выгруженные справочники доступны PHP-скриптам, но не по HTTP.
<FilesMatch "^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>

RedirectMatch 404 ^/api/lib/
RedirectMatch 404 ^/api/site-data\.generated\.json$
RedirectMatch 404 ^/api/nginx\.sample\.conf$
RedirectMatch 404 ^/storage(/|$)

# --- Защитные заголовки ----------------------------------------------------
# HSTS без includeSubDomains намеренно: сертификат почтового поддомена пока
# не выпущен, и директива сломала бы к нему доступ по HTTPS. Добавить, когда
# сертификат будет на месте.
#
# Content-Security-Policy. Разбор по директивам, потому что каждая тут
# выбрана под конкретную особенность сайта, а не по общему списку.
#
# default-src 'self' — базовое правило: всё своё. Ниже только исключения.
#
# script-src разрешает 'unsafe-inline' сознательно. Инлайновых блоков два:
# JSON-LD (содержимое различается от страницы к странице) и сниппет Метрики.
# Попостраничные хеши в один заголовок на весь сайт не помещаются, для них
# нужна генерация <meta> на каждую страницу в postprocess-dist.py — отдельная
# работа, см. backlog.md. Инъекцию инлайна такая политика не остановит, зато
# остановит внедрение чужого <script src>: своих внешних скриптов у сайта
# нет ни одного, кроме перечисленных здесь.
#
# frame-src открыт для yandex.ru — на страницах подразделений стоят виджеты
# Яндекс.Карт (city-v2.html). Без этой строки карты просто исчезнут.
#
# connect-src и img-src ограничивают, КУДА страница может отправить данные.
# На каждой странице форма с телефоном и почтой, поэтому это важнее строгости
# script-src: даже если чужой код окажется на странице, увезти собранное ему
# будет некуда.
#
# style-src допускает 'unsafe-inline' из-за атрибутов style= в разметке;
# отдельных <style> в шаблонах нет.
#
# mc.yandex.ru прописан заранее, чтобы включение Метрики сводилось к вводу
# номера счётчика в config.regru.yaml. Пока номер пуст, счётчика на страницах
# нет вовсе. Если после включения счётчик не заработает — смотреть консоль
# браузера: нарушение CSP называет заблокированный адрес прямо. Вероятный
# кандидат — Вебвизор, ему может потребоваться 'unsafe-eval'; включать его
# отдельным решением, он записывает сеанс, а на страницах персональные данные.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; font-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-src https://yandex.ru https://mc.yandex.ru; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Кеш ассетов -----------------------------------------------------------
# Имена файлов без хеша, поэтому длинный кеш опасен: после выкладки посетитель
# получит новую разметку со старым CSS. Короткий срок плюс ETag.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|svg|png|jpg|jpeg|webp)$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
